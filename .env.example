# --- Core ---
MONGODB_URI=mongodb://localhost:27017/swetaranya
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin auth (NextAuth v4, credentials + JWT) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
# Used by scripts/seed.ts to create the first admin
SEED_ADMIN_EMAIL=admin@swetaranya.local
SEED_ADMIN_PASSWORD=change-me-now

# --- Email (Resend). Leave blank in dev: emails are logged to the console instead. ---
RESEND_API_KEY=
EMAIL_FROM="Swetaranya <care@swetaranya.com>"
EMAIL_TEAM_INBOX=

# --- Public media (Cloudinary) — public imagery ONLY ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Private medical reports (DigitalOcean Spaces) — separate bucket + credentials, never public ---
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_REGION=blr1
SPACES_BUCKET=swetaranya-medical-private
SPACES_KEY=
SPACES_SECRET=
# Days a medical report is kept before it is due for deletion
REPORT_RETENTION_DAYS=365
# Signs booking links and single-use upload tokens
SIGNING_SECRET=replace-with-openssl-rand-base64-32
# Bearer secret for POST /api/cron/purge-reports (the report retention purge), called by a
# DigitalOcean scheduled job with "Authorization: Bearer <CRON_SECRET>". openssl rand -base64 32
CRON_SECRET=replace-with-openssl-rand-base64-32

# --- WhatsApp (stubbed in Phase 1) ---
WHATSAPP_NUMBER=919000000000
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
